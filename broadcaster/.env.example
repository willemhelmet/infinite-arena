# ---------------------------------------------------------------- Reactor ---
# The fast-h3 session this process owns. Hosted: set the API key (rk_...).
# Local: leave it empty and pass --local (or REACTOR_LOCAL=1) for `reactor run`.
REACTOR_MODEL=fast-h3
REACTOR_API_KEY=
# REACTOR_LOCAL=1
# REACTOR_LOCAL_URL=http://localhost:8080

# ------------------------------------------------------------- The arena ---
# The deployed web app: chat, show state, fighters, and the coordinator all
# live there. BROADCASTER_SECRET must equal the web app's env var of the same
# name; it is what lets this process post as the Arena and publish the show.
ARENA_URL=https://infinite-arena.vercel.app
BROADCASTER_SECRET=
ARENA_NAME=Infinite Arena

# --------------------------------------------------------------- The show ---
# Arena establishing shots keep the queue topped up to this many clips while nothing else is
# queued (self-clamps under the deployment's playout capacity). 0 disables.
IDLE_QUEUE_TARGET=4
# Allow for the player delivery buffer before posting the final result.
PLAYBACK_DELAY_S=12
CHAT_POLL_S=1.0

# ----------------------------------------------------------------- Output ---
# hls  — the arena streams itself: ffmpeg writes HLS into HLS_DIR and this
#        process serves it on HLS_PORT with CORS. Point the web app's
#        NEXT_PUBLIC_STREAM_URL at http(s)://<this host>:<port>/live.m3u8.
# rtmp — push to an RTMP ingest you run instead (RTMP_URL).
# noop — no encoder; the whole pipeline runs, frames are discarded.
SINK=hls
HLS_DIR=./hls
HLS_PORT=8088
HLS_SEGMENT_S=2
# RTMP_URL=rtmp://localhost/live/arena
VIDEO_BITRATE_K=4500
OVERLAY_ENABLED=1

# Optional external announcers. Set all three to enable Fish speech.
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_SECONDARY_REFERENCE_ID=
FISH_MODEL=s2-pro

# Experimental buffered ntsc-rs output; default off. Adds measured startup delay.
VHS_ENABLED=0
NTSC_RS_CLI=ntsc-rs-cli
# VHS_PRESET defaults to broadcaster/presets/vhs.json

# Hosted workers must verify Vercel has working shared storage.
REQUIRE_SHARED_STORE=0

# Twitch-only production: no Vercel or Redis required.
CONTROL_PLANE=twitch
TWITCH_CHANNEL=
# Optional bot user access token with chat:read and chat:edit; never paste in chat.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
# OPENAI_API_KEY belongs on the Python worker in this mode.
