# Required (later, for the live H3 fight feed). The server mints short-lived,
# session-scoped JWTs from this; the browser never sees the raw key. rk_... from
# https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=

# Optional: AI-generated fighter portraits (Create Fighter -> Generate),
# served by /api/fighters/generate-image. Without it, upload-only.
# r8_... from https://replicate.com/account/api-tokens
# REPLICATE_API_KEY=

# Optional (later): the LLM narrative coordinator that resolves each round's
# two attacks into the next scene prompt.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional in local dev: durable public URLs for uploaded/generated fighter
# images (H3 needs a real https URL) plus the shared community fighter pool.
# Auth resolution (first match wins):
#   1. VERCEL_OIDC_TOKEN + BLOB_STORE_ID — protected-store OIDC (auto-rotates;
#      populated by `vercel env pull` / at deploy time)
#   2. BLOB_READ_WRITE_TOKEN             — classic store read/write token
# Without either, images fall back to data: URIs and the pool falls back to
# per-device localStorage.
# VERCEL_OIDC_TOKEN=
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
